# ── 主力对话：自有中转（OpenAI 兼容）────────────────────────────────
# 复制本文件为 .env.local 并填入真实值。.env.local 不会进入 git。
# 真实密钥只写在 .env.local / 云端环境变量，不要提交到 git。

RELAY_BASE_URL=https://relay.protocom.org/v1
RELAY_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：桌面「自由中转」使用的上游模型 ID。网页版可不填。
# RELAY_MODEL_ID=
# Optional per-model relay overrides. IDs must exactly match the relay catalog.
# Vendor-specific thinking styles remain available for custom API connections.
# RELAY_MODEL_CONFIG={"deepseek/deepseek-v4.1-flash":{"apiModelId":"deepseek/deepseek-v4.1-flash","thinkingRequestStyle":"openai-reasoning-effort","enabled":true}}

# env 默认模型（站点默认 AI）。菜单可切换到其它已注册模型，
# 或在「设置」里填入自定义 URL/API/模型（与 env 并存不冲突）。
AI_MODEL_PRO=Qwen/Qwen3.8-27B
AI_MODEL_FLASH=z-ai/glm-5.3-flash

# 思考流字段名（DeepSeek/GLM/Qwen 系默认 reasoning_content；不同则改这里）
AI_REASONING_FIELD=reasoning_content

# ── 联网搜索（三家源，可分别覆盖）──────────────────────────────────
# 默认优先级 Kimi > 智谱 > Perplexity；权威性 Perplexity > Kimi > 智谱；
# 成本（越靠前越便宜）智谱 > Kimi > Perplexity。用户也可在设置里逐个填自己的 key。
#  - 智谱：/api/paas/v4/web_search（复用上面的 ZHIPU_API_KEY）
#  - Kimi：Moonshot 内置 $web_search（平台侧搜索，模型回灌 tool_call 后产出带引用的结论）
#  - Perplexity：优先 /search，失败退 sonar
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：搜索用的 Kimi 模型（k2.6 比 k3 便宜快）
# KIMI_SEARCH_MODEL=kimi-k2.6
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxx

# ── 七牛云 AI（qnaigc，OpenAI 兼容）─────────────────────────────────
# 主力文本供应商：GLM 5.3 Flash / DeepSeek V4.1 Flash / Qwen3.7 Flash 的 endpoints 链
# 第一位就是它（延迟最低），Protocom 中转排在后面做容灾降级。
# 注意方言差异（实机验证过）：GLM 5.3 Flash 在该站「始终思考、不可关闭」，只能调
# reasoning_effort(low/high/max)；DeepSeek 与 Qwen 用 thinking:{type:enabled|disabled} 真正开关。
QINIU_BASE_URL=https://api.qnaigc.com/v1
QINIU_API_KEY=sk-xxxxxxxxxxxxxxxx
# 极轻量快速模型（仅「自动路由选模型」与「标签页命名」用；强制关思考 + temperature 0 + 极小 max_tokens）
AI_FAST_MODEL=doubao-seed-2.0-mini

# ── 生图中转站 xhuoai（OpenAI 兼容）────────────────────────────────
# nano-banana / gpt-image-2 / gpt-image-2.5：单张 ¥1，实测 100–400s。
# 前端有按模型预估的进度条（到 99% 会稳住不冲，提前完成直接出图）。
XHUOAI_BASE_URL=https://api.xhuoai.com/v1
XHUOAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 硅基流动 SiliconFlow（生图 + 向量/重排）────────────────────────
# 生图只认 SILICONFLOW_*；base 不会回落 AI_BASE_URL（那里常填中转站，
# 而中转站不提供 Tongyi-MAI/Z-Image-Turbo）。key 未填时仍回落 AI_API_KEY。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
# 向量 / 重排仍读 AI_BASE_URL（默认即硅基流动）。
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 小米 MiMo Token Plan（OpenAI 兼容；密钥格式 tp-xxxxx）──────────
# 订阅页：https://platform.xiaomimimo.com/token-plan
# 中国集群：https://token-plan-cn.xiaomimimo.com/v1
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=

# ── 向量 / 重排（语义检索，复用 SiliconFlow 端点）────────────────────────
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 可选：检索模式（hybrid/vector/keyword）。留空或 hybrid 为默认推荐。
AI_SEARCH_MODE=hybrid

# 检索索引只认本地 content/.index/（随部署产物分发，运行时不再从远端回退）。

# ── 智谱官方 API（向量/重排容灾 + 联网搜索；对话模型已下架）────────
# 在 https://open.bigmodel.cn 申请 key 后填入；留空则向量容灾与联网搜索不可用。
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=

# 智谱官方向量/重排模型（当 SiliconFlow 不可用时降级使用）
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_RERANK_MODEL=rerank

# ── 联网搜索（智谱 Web Search API）──────────────────────────────────
# 复用上面的 ZHIPU_API_KEY；留空则联网搜索工具返回"未配置"。

# ── 图片搜索（Unsplash API）──────────────────────────────────
# 在 https://unsplash.com/oauth/applications 申请 Access Key 后填入
# 留空则图片搜索工具返回「未配置」，模型不应反复重试搜图。
UNSPLASH_ACCESS_KEY=

# ── 视频 CDN 托管 ────────────────────────────────────────────────────
# MP4 文件（~900MB）已从仓库移除，托管在对象存储 / CDN 上。
# 留空则视频从 public/media/videos/ 本地提供（需文件存在）。
# 设置后前端自动将 /media/videos/ 前缀替换为此 base URL。
NEXT_PUBLIC_VIDEO_CDN_BASE=

# ── 站点根 URL（分享链接）─────────────────────────────────────────────
# 本机留空即可：分享链接按浏览器当前 origin 生成（dev 默认 http://localhost:35349）。
# 生产必须显式写死成线上域名，否则会生成 http://localhost:35349/s/... 这种谁都打不开的死链。
# 末尾不要带 /。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── Supabase（账号 / 额度 / 兑换码）──
# 浏览器只认 NEXT_PUBLIC_*（必须写死这个前缀，打包才会打进前端）。
# 旧 JWT（anon / service_role）与新 sb_publishable_ / sb_secret_ 都可用。
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=

# ── 统一账号（Account 共享会话）──────────────────────────────────────
# 2026-09-28 起，*.1037solo.com 上的身份唯一来源是 Account 写在 .1037solo.com
# 域下的共享会话 cookie（access_token / refresh_token / remember_me）。
# StudySolo 不再维护自己的登录会话，判定逻辑集中在 lib/auth/authMode.ts。
#
# ACCOUNT_BACKEND_URL：生产必填。StudySolo 用它把浏览器的 Cookie 与 Origin 转发给
#   Account 的 /api/auth/{browser-session|refresh|logout}。未配置时相关接口明确返回
#   503，不再静默回退到 127.0.0.1:3041。仓库里不写死任何部署环境地址。
ACCOUNT_BACKEND_URL=https://account.1037solo.com
# NEXT_PUBLIC_ACCOUNT_URL：登录按钮跳转的账号中心地址（留空时默认同上）。
# NEXT_PUBLIC_ACCOUNT_URL=https://account.1037solo.com
# APP_ALLOWED_ORIGINS：允许调用本站 /api/account/* 的来源，逗号分隔。
# APP_ALLOWED_ORIGINS=https://studysolo.1037solo.com
#
# 本机开发（next dev，用 http://localhost:35349 打开）不需要配置以上任何一项：
#   登录去本机 Account（http://localhost:3040），会话转发给本机后端（http://127.0.0.1:3041）。
#   即使这里写了线上地址，本机开发也不会用它（线上登录态在 .1037solo.com，本机读不到）。
#   本机 Account 后端的 CORS_ORIGINS 需包含 http://localhost:35349。
#   用 127.0.0.1:35349 打开读不到 localhost 上的登录态，请用 localhost。

# 以下两项只服务于自签 OAuth 通道（仅生产构建里的 localhost 与未知主机会进入）。
# 生产 *.1037solo.com 与历史域名都不再进入该通道，因此线上无需配置：
# SUPABASE_OAUTH_CLIENT_ID=
# SUPABASE_OAUTH_CLIENT_SECRET=   # 该 OAuth 客户端是公开客户端，配了反而会被拒绝

# ── 阿里云 DirectMail（Supabase Auth 自定义 SMTP；密码只写 .env.local）──
# ALIYUN_SMTP_HOST=
# ALIYUN_SMTP_PORT=
# ALIYUN_SMTP_USER=
# ALIYUN_SMTP_PASSWORD=
# ALIYUN_SMTP_SENDER_NAME=
# 逻辑外备：AES 口令只写本地 / GitHub secret，产物默认 tmp/db-backups/
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIR=tmp/db-backups

# ── 离线工具（非运行时，脚本使用）─────────────────────────────────────
# MinerU PDF 解析（scripts/parse-docs.ts 等脚本调用 OpenXLab API）
# 在 https://openxlab.org.cn 申请后填入。
# MinerU_API_Token=
