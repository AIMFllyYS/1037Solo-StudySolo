{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "lib/ai",
    "outDir": "runtime/search-worker",
    "noEmitOnError": true
  },
  "include": ["lib/ai/indexing/bm25Index.ts", "lib/ai/search/worker/**/*.mts"]
}
