{
  "name": "gailvlun",
  "version": "0.5.1",
  "private": true,
  "description": "StudySolo · 多学科辅助学习应用",
  "author": "Gailvlun",
  "main": "electron/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit --incremental false",
    "dev": "next dev -p 35349",
    "check:encoding": "node scripts/check-content-encoding.mjs",
    "gen:script-ids": "node scripts/gen-script-ids.mjs",
    "prebuild": "node scripts/check-content-encoding.mjs && npx tsx scripts/gen-lectures-manifest.ts && npx tsx scripts/check-lectures.ts && npx tsx scripts/gen-nav-manifest.ts && npx tsx scripts/check-registry-consistency.ts && node scripts/gen-script-ids.mjs && node scripts/check-katex-chars.mjs && node scripts/check-recording-example-latex-escapes.mjs && node scripts/check-media-sync.mjs && node scripts/check-prose-svg-rules.mjs && node scripts/run-unit-tests.mjs --filter=code",
    "check:registry": "npx tsx scripts/check-registry-consistency.ts",
    "check:hydration": "python scripts/check-hydration.py",
    "gen:lectures": "npx tsx scripts/gen-lectures-manifest.ts",
    "check:lectures": "npx tsx scripts/check-lectures.ts",
    "build": "next build",
    "start": "next start -p 35349",
    "lint": "eslint . && knip && node --import tsx scripts/check-secrets.ts",
    "lint:eslint": "eslint .",
    "lint:knip": "knip",
    "lint:secrets": "node --import tsx scripts/check-secrets.ts",
    "lint:fix": "eslint . --fix",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build-index": "npx tsx scripts/build-index.ts",
    "gen-nav": "npx tsx scripts/gen-nav-manifest.ts",
    "render": "python manim/render.py",
    "render:chapter": "python manim/render.py --chapter",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "electron .",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs --filter=code",
    "test:content": "node scripts/run-unit-tests.mjs --filter=content",
    "test:react": "vitest run --passWithNoTests",
    "test:all": "node scripts/run-all-tests.mjs --include-content",
    "test:watch": "vitest",
    "test:cov": "node scripts/run-unit-tests.mjs --filter=code && vitest run --coverage --passWithNoTests",
    "db:migrate": "npx tsx scripts/db-migrate.ts up",
    "db:migrate:status": "npx tsx scripts/db-migrate.ts status --compare",
    "db:migrate:compare": "npx tsx scripts/db-migrate.ts compare",
    "db:keepalive": "npx tsx scripts/db-keepalive.ts",
    "db:backup": "npx tsx scripts/db-backup.ts dump",
    "db:backup:usage": "npx tsx scripts/db-backup.ts usage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.46",
    "@ai-sdk/openai-compatible": "3.0.41",
    "@ai-sdk/provider": "4.0.9",
    "@dagrejs/dagre": "3.1.1",
    "@milkdown/crepe": "7.22.0",
    "@rdkit/rdkit": "2025.3.4-1.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-virtual": "^3.14.4",
    "@vidstack/react": "1.15.6",
    "@xyflow/react": "12.11.5",
    "ai": "7.0.85",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.7.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "framer-motion": "^11.18.0",
    "idb-keyval": "^6.2.5",
    "katex": "^0.16.21",
    "lucide-react": "^1.20.0",
    "mammoth": "^1.12.2",
    "next": "16.2.9",
    "pdfjs-dist": "5.5.207",
    "pptx-preview": "^1.0.7",
    "radix-ui": "1.4.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^9.0.3",
    "react-resizable-panels": "^2.1.7",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "sonner": "2.0.7",
    "streamdown": "2.3.0",
    "tailwind-merge": "3.5.0",
    "undici": "^6.27.0",
    "unified": "11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.1.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^26.0.0",
    "knip": "^6.34.0",
    "postcss": "^8.5.1",
    "remark-rehype": "11.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.1.0"
  }
}
