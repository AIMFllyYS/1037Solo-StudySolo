# dependencies
node_modules/
.pnp/
.pnp.*

# next.js
.next/
.next-class-verify/
out/
next-env.d.ts

# electron desktop build output
dist-desktop/

# electron-builder build resources: track the icon assets, never track signing material
build/*
!build/logo.svg
!build/icon.ico
!build/icon.png
!build/installer-icon.ico
!build/installer-icon.png
# code-signing material must NEVER be committed (kept in %LOCALAPPDATA%\Gailvlun)
*.pfx
*.pwd

# env (keep .env.example tracked; all other variants/renames stay out of git)
.env*
!.env.example
.mcp

# key/cert material — must never be committed
*.key
*.pem
*.p12

# manim intermediate render cache (final mp4s live in public/media)
manim/media*/
# stray LaTeX temp dir created if manim runs without --media_dir at repo root
/media/
__pycache__/
*.pyc
.venv/
venv/

# misc
.DS_Store
*.log
# Agent SDK lifecycle JSONL (server writes log/; Electron writes userData)
/log/
npm-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
.idea/
.vscode/

# archived one-off scripts (not part of the app build)
/scripts/archive/
/scripts/logs/
/scripts/temp/
/scripts/pdf_extracts/
/scripts/transcripts/
/scripts/handoffs/

# ZIP / tarball archives
*.zip
*.tar.gz

# Temporary files
tmp/

# 根目录下划线前缀的一次性抓取/导出产物（云盘列目录、课表 JSON、临时脚本、_tmp_* 工作目录）。
# 约定：绝不允许这些临时文件进入版本库。
/_*
# 云盘/飞书下载清单等临时文本导出
/download.txt

# Source files copied for ingest (extracted markdown goes to content/_raw or content/)
content/_raw-src/
tmp_*
.cache/

# Local MinerU / Word image dumps. Curated figures live in
# public/{subject}/{category}/images/ or public/images/{subject}/textbook|detail|...
public/images/anatomy/lecture/
public/images/anatomy/pharmacy-outline/
public/images/histology/05-q/
public/images/histology/05-qa/
public/images/histology/07-nursing-qa/

# Video files are hosted on CDN (see NEXT_PUBLIC_VIDEO_CDN_BASE).
# Posters (~1MB) stay in public/media/posters/ and are tracked.
public/media/videos/

# semantic search index (generated by npm run build-index)
content/.index/

.claude/
.trae/
.mimocode/
.workbuddy/
.kiro/

# backup / typo directories
content/probability/shizhan-yanlian/_backup_v1/
content/probability/shizyan-yanlian/
content/_raw/

# plan verification artifacts (screenshots, probe dumps)
docs/plans/**/verify/
/artifacts/performance/
/artifacts/connector-analysis-*/
/artifacts/connector-auth-*/
/runtime/search-worker/
/.next-perf-*/
/.next-desktop-*/
/dist-desktop-staged-*/

# local lecture-ingest visual acceptance screenshots (never committed)
.accept_shots/

# Supabase CLI 的临时态（db query/push 会写 project ref 与版本号，不是真相源）
supabase/.temp/

# Preserved dependency snapshot
.local-archive/

1037Solo-Classolo/
