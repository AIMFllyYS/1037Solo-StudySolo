# Keep source files as LF to prevent CRLF churn on Windows checkouts.
# (Two physics scene files had silently flipped to CRLF, producing ~1800
#  lines of phantom diff; this enforces LF going forward.)
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.sh   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf

# Treat media as binary (no EOL conversion, no diff).
*.mp4  binary
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.svg  binary

# User-provided skill references intentionally use Markdown two-space hard breaks.
lib/sandbox/skill-packs/**/*.md whitespace=-blank-at-eol

# Original documentation snapshots have SHA256 receipts for their exact captured bytes.
docs/archive/refactor-2026-10-10/document-entrypoints/root/** -text whitespace=cr-at-eol,-blank-at-eol
docs/archive/refactor-2026-10-10/document-entrypoints/docs/** -text whitespace=cr-at-eol,-blank-at-eol
docs/archive/refactor-2026-10-10/historical-docs/** -text whitespace=cr-at-eol,-blank-at-eol
docs/archive/refactor-2026-10-10/retired-source/** -text whitespace=cr-at-eol,-blank-at-eol
docs/archive/refactor-2026-10-10/symbol-cleanup/**/*.txt -text whitespace=cr-at-eol,-blank-at-eol
docs/archive/refactor-2026-10-10/audit-probe-sources/*.txt -text whitespace=cr-at-eol,-blank-at-eol
