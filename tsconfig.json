{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-class-verify/types/**/*.ts",
    ".next-class-verify/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "manim",
    "docs/refer/dist",
    "showroom",
    "exhibition-hall",
    "dist-desktop",
    "scripts/one-off",
    ".local-archive",
    "1037Solo-Classolo",
    "1037Solo-StudySolo"
  ]
}
